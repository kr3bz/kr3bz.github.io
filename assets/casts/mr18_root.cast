[1.82, "o", "\r\n"]
[2.22, "o", "\u001b[36m[1/4] cleaning up leftover bridge/openocd...\u001b[0m\r\n"]
[4.22, "o", "\u001b[36m[2/4] starting the EJTAG bridge (ONE, never restarted)...\u001b[0m\r\n"]
[6.22, "o", "\u001b[32m[+] bridge up (pid 166653)\u001b[0m\r\n"]
[6.72, "o", "\u001b[36m[3/4] warming the TAP \u2014 make sure the MR18 is at its <Meraki> prompt\u001b[0m\r\n"]
[8.52, "o", "   \u001b[33mwarm 1: cold (flaky) \u2014 warming...\u001b[0m\r\n"]
[10.32, "o", "   \u001b[33mwarm 2: cold (flaky) \u2014 warming...\u001b[0m\r\n"]
[12.12, "o", "   \u001b[32mwarm 3: TAP read OK  (1/2)\u001b[0m\r\n"]
[13.92, "o", "   \u001b[32mwarm 4: TAP read OK  (2/2)\u001b[0m\r\n"]
[14.32, "o", "\u001b[32m\u001b[1m[+] TAP warm.\u001b[0m\r\n"]
[14.92, "o", "\r\n"]
[15.22, "o", "\u001b[33m\u001b[1m>>> NOW POWER-CYCLE THE MR18, and again every ~40s until it lands <<<\u001b[0m\r\n"]
[15.52, "o", "\u001b[36m[4/4] hijack loop running (Ctrl-C to stop)...\u001b[0m\r\n"]
[16.72, "o", "\u001b[36m===== RUN 1 =====\u001b[0m\r\n"]
[18.72, "o", "   \u001b[33m(flaky TDO / wrong window \u2014 power-cycle & keep going)\u001b[0m\r\n"]
[19.92, "o", "\u001b[36m===== RUN 2 =====\u001b[0m\r\n"]
[21.92, "o", "   \u001b[33m(flaky TDO / wrong window \u2014 power-cycle & keep going)\u001b[0m\r\n"]
[23.12, "o", "\u001b[36m===== RUN 3 =====\u001b[0m\r\n"]
[24.72, "o", "   hit 0: pc=0x48a500 a0=0x2\r\n"]
[25.12, "o", "   \u001b[32mRESUMED-PWN\u001b[0m\r\n"]
[25.72, "o", "\r\n\u001b[32m\u001b[1m"]
[25.87, "o", "   \u2588\u2588\u2588\u2588\u2588\u2588   \u2588\u2588\u2588\u2588\u2588\u2588   \u2588\u2588\u2588\u2588\u2588\u2588  \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588   root@MR18\r\n"]
[26.07, "o", "\u001b[0m"]
[26.37, "o", "\u001b[32m[+] RESUMED-PWN \u2014 execve('/bin/sh') fired.\u001b[0m\r\n"]
[26.77, "o", "\u001b[36m[*] opening the root console (do NOT type 'exit' \u2014 it's PID 1)...\u001b[0m\r\n"]
